PORT=5003
GRPC_PORT=50053
NODE_ENV=development
LOG_LEVEL=INFO

# Database Settings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dataset_catalog_db

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# Event Streaming & Messaging Settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Kafka Topics
TOPIC_DATASET_ACQUIRED=dataset.acquired
TOPIC_DATASET_REGISTERED=dataset.registered
TOPIC_DATASET_PROCESSING_STARTED=dataset.processing.started
TOPIC_DATASET_PROCESSING_COMPLETED=dataset.processing.completed
TOPIC_DATASET_PROCESSING_FAILED=dataset.processing.failed
TOPIC_DATASET_READY=dataset.ready

# RabbitMQ Queues
QUEUE_PREPROCESSING_JOBS=dataset.preprocessing

# Application Settings
SERVICE_NAME=dataset-catalog-service
