# ==============================================================================
# Dataset Serving Service Environment Configuration
# ==============================================================================

# Core Service Settings
PORT=5005
HOST=0.0.0.0
ENVIRONMENT=development
SERVICE_NAME=dataset-serving-service
LOG_LEVEL=INFO

# Caching & Redis Configuration (L2 Query Cache & Rate Limiting)
REDIS_URL=redis://localhost:6379/1
QUERY_CACHE_TTL_SECONDS=300
METADATA_CACHE_TTL_SECONDS=1800
ENABLE_CACHE=true

# Object Storage (MinIO / S3) - Source for Standardized Parquet Datasets
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PROCESSED=processed-data
S3_USE_SSL=false

# Dataset Catalog Service Integration
CATALOG_SERVICE_URL=http://localhost:5003
CATALOG_GRPC_HOST=localhost
CATALOG_GRPC_PORT=50053

# Rate Limiting & Protection
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30

# Analytical Engine (DuckDB & PyArrow) Guardrails
MAX_SCAN_ROWS_LIMIT=500000
MAX_PAGE_SIZE=1000
DEFAULT_PAGE_SIZE=50
QUERY_TIMEOUT_SECONDS=15
DUCKDB_MAX_MEMORY_MB=1536
DUCKDB_THREADS=4
ENABLE_SQL_SANDBOX=true

# Authentication & Security
JWT_SECRET=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
REQUIRE_AUTH=false
