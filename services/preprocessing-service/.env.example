# ==============================================================================
# Preprocessing Service Environment Configuration
# ==============================================================================

# Core Service Settings
PORT=5004
HOST=0.0.0.0
ENVIRONMENT=development
SERVICE_NAME=preprocessing-service
LOG_LEVEL=INFO

# RabbitMQ AMQP Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=dataset.preprocess.jobs
RABBITMQ_DLQ=dataset.preprocess.dlq
RABBITMQ_PREFETCH_COUNT=2
RABBITMQ_MAX_RETRIES=3

# Kafka Event Streaming Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREPROCESSED=dataset.preprocessed
KAFKA_TOPIC_FAILED=dataset.preprocess.failed

# Redis State & Idempotency Store
REDIS_URL=redis://localhost:6379/0
IDEMPOTENCY_TTL_SECONDS=3600

# S3 / MinIO Object Storage
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RAW=raw-datasets
S3_BUCKET_PROCESSED=processed-data
S3_USE_SSL=false

# Dataset Catalog Service Integration
CATALOG_SERVICE_URL=http://localhost:5003

# Guardrails & Non-Functional Resource Limits
MAX_MEMORY_MB=2048
PROCESSING_TIMEOUT_SECONDS=300
MAX_CHUNK_SIZE_ROWS=10000
MAX_FILE_SIZE_BYTES=524288000
MAX_DECOMPRESSED_RATIO=10
TEMP_SCRATCH_DIR=./tmp/scratch
