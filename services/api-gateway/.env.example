# API Gateway Microservice Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (Gateway Registry & Audit Logs)
MONGO_URI=mongodb://localhost:27017/ai_api_gateway_db

# Security & JWT
JWT_SECRET=super_secret_gateway_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d
API_KEY_SALT=gateway_secure_salt_key_98765

# Internal Microservices Endpoints
DISCOVERY_SERVICE_URL=http://localhost:5001
WORKSPACE_SERVICE_URL=http://localhost:5002

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
